@page "{id:int}"
@model EventManagementSystem.Pages.Events.DeleteModel
@{
    ViewData["Title"] = "Delete Event";
}

<div class="eyebrow">SLIC Life</div>
<h1>Delete Event</h1>

<div class="notice-banner notice-warning">
    Are you sure you want to delete <strong>@Model.Event.Title</strong>? This will also remove all registrations and attendance records tied to this event. This can't be undone.
</div>

<form method="post">
    <input type="hidden" asp-for="Event.EventId" />
    <div class="action-row">
        <button type="submit" class="btn btn-danger">Delete Event</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </div>
</form>
