@page "{id:int}"
@model EventManagementSystem.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Event.Title;
}

<div class="eyebrow">SLIC Life</div>
<h1>@Model.Event.Title</h1>

@if (Model.Event.Status == "Cancelled")
{
    <div class="notice-banner notice-cancelled">This event has been cancelled. Registered attendees have been notified.</div>
}

<div class="panel">
    <div class="detail-row">
        <span class="detail-label">Date</span>
        <span class="detail-value">@Model.Event.EventDate.ToString("dd MMM yyyy, h:mm tt")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Venue</span>
        <span class="detail-value">@Model.Event.Venue</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Capacity</span>
        <span class="detail-value">@Model.Event.RegisteredCount / @Model.Event.Capacity registered</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value">
            @if (Model.Event.Status == "Scheduled")
            {
                <span class="badge badge-registered">Scheduled</span>
            }
            else if (Model.Event.Status == "Cancelled")
            {
                <span class="badge badge-cancelled">Cancelled</span>
            }
            else
            {
                <span class="badge badge-completed">Completed</span>
            }
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Event.Description))
    {
        <p class="detail-description">@Model.Event.Description</p>
    }
</div>

@if (!User.Identity!.IsAuthenticated)
{
    <p><a asp-page="/Account/Login">Log in</a> to register for this event.</p>
}
else if (Model.MyRegistration is null)
{
    @if (Model.Event.Status == "Scheduled")
    {
        <form method="post">
            <input type="hidden" name="eventId" value="@Model.Event.EventId" />
            <button type="submit" class="btn">Register</button>
        </form>
    }
}
else
{
    <p>
        You are
        @if (Model.MyRegistration.Status == "Registered")
        {
            <span class="badge badge-registered">Registered</span>
        }
        else if (Model.MyRegistration.Status == "Waitlisted")
        {
            <span class="badge badge-waitlisted">Waitlisted</span>
        }
        for this event.
        <a asp-page="/Registrations/MyEvents">View your QR ticket</a>
    </p>
}

@if (User.IsInRole("Admin"))
{
    <div class="action-row">
        <a class="btn" asp-page="Edit" asp-route-id="@Model.Event.EventId">Edit</a>
        <a class="btn btn-danger" asp-page="Delete" asp-route-id="@Model.Event.EventId">Delete</a>
        <a class="btn btn-secondary" asp-page="/Registrations/Attendees" asp-route-eventId="@Model.Event.EventId">View Attendees</a>
    </div>
}

<p style="margin-top: 20px;"><a asp-page="Index">Back to events</a></p>
