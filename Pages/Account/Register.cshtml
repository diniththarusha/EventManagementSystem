@page
@model EventManagementSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>Register</h1>

<form method="post">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <label asp-for="FullName"></label>
    <input asp-for="FullName" />

    <label asp-for="Email"></label>
    <input asp-for="Email" />

    <label asp-for="Password"></label>
    <input asp-for="Password" type="password" />

    <p><button type="submit" class="btn">Create account</button></p>
</form>

<p>Already have an account? <a asp-page="Login">Login here</a></p>
