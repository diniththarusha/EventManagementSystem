@page
@model EventManagementSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="eyebrow">SLIC Life</div>
        <h1>Create your account</h1>

        <form method="post">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <label asp-for="FullName"></label>
            <input asp-for="FullName" />

            <label asp-for="Email"></label>
            <input asp-for="Email" />

            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" />

            <button type="submit" class="btn">Create account</button>
        </form>

        <p class="auth-footer">Already have an account? <a asp-page="Login">Login here</a></p>
    </div>
</div>
