@page
@model EventManagementSystem.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<h1>Notifications</h1>

@if (!Model.Notifications.Any())
{
    <p>No notifications yet.</p>
}

@foreach (var n in Model.Notifications)
{
    <div class="panel @(n.IsRead ? "" : "unread")">
        <p style="margin:0;">@n.Message</p>
        <p style="margin:4px 0 0; font-size:0.85em; color:var(--text-muted);">@n.CreatedAt.ToString("dd MMM yyyy, h:mm tt")</p>
    </div>
}
